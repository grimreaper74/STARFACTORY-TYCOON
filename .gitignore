# --- Unreal generated / regenerable -----------------------------------------
/Binaries/
/DerivedDataCache/
/Intermediate/
/Saved/
/Builds/
/Build/
/.vs/
/.idea/
*.VC.db
*.suo
*.opensdf
*.sdf
*.tmp
*.log

# Generated solution/project files
*.sln
*.slnx
*.xcodeproj
*.xcworkspace
UpgradeLog*.htm

# Plugin build output - the root /Binaries/ and /Intermediate/ rules above
# are root-anchored and do not reach a plugin's own Binaries/Intermediate
# (e.g. Plugins/AgentZet/Binaries, 338 MB - caught this one by hand while
# staging a commit rather than by pattern, hence adding the pattern now).
Plugins/*/Binaries/
Plugins/*/Intermediate/

# --- Large binary trees: deliberately NOT in git ----------------------------
# Content is ~7 GB of .uasset and SourceAssets is ~50 GB of DCC source.
# Git cannot hold these sensibly without LFS. They are excluded so that the
# code, scripts, configuration and documentation are versioned immediately.
# To bring binaries under version control later, install Git LFS and track
# *.uasset / *.umap / *.fbx / *.blend before un-ignoring these directories.
/Content/
/SourceAssets/
# Same reasoning: ArchivedCarEraContent (~15 GB) and ArtSource (~1.3 GB) are
# the same class of binary tree, just archived/renamed rather than deleted.
# ArchivedCarEraSource is deliberately NOT here - it holds the superseded
# car-era .cpp/.h source kept as evidence, a few MB of text, not binaries.
/ArchivedCarEraContent/
/ArtSource/

# --- Local scratch / stray artefacts ----------------------------------------
/work/
/B/
/LineBossCarFactory_Unreal 5.8/
NUL.sarif
CON

# Python bytecode from editor automation
__pycache__/
*.py[cod]
Packaged/

# Downloaded third-party assets (owner, 2026-09-02): archives and extractions, gigabytes, manifests beside them
/assets downloads/
